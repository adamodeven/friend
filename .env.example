APP_ENV=development
APP_NAME=friend
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
TIMEZONE=America/New_York

DATABASE_URL=postgresql+psycopg://friend:friend@postgres:5432/friend
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_TEXT_MODEL=llama3.2:1b
OLLAMA_FALLBACK_TEXT_MODEL=llama3.2:1b
OLLAMA_VISION_MODEL=llava:13b
OLLAMA_PULL_VISION_ON_STARTUP=false
OLLAMA_TIMEOUT_SECONDS=45
OLLAMA_KEEP_ALIVE=30m
OLLAMA_AUTO_PULL_MISSING_MODELS=true
OLLAMA_WARMUP_ON_STARTUP=true
OLLAMA_CONTEXT_LENGTH=2048
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_MAX_QUEUE=128
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0
OLLAMA_DOCKER_RUNTIME=runc
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility
OLLAMA_INTENT_NUM_CTX=512
OLLAMA_INTENT_NUM_PREDICT=96
OLLAMA_OPTION_NUM_THREAD=4
OLLAMA_OPTION_NUM_BATCH=64
OLLAMA_OPTION_LOW_VRAM=false
# OLLAMA_OPTION_NUM_GPU=999
# OLLAMA_OPTION_MAIN_GPU=0

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TO_NUMBER=
TWILIO_WEBHOOK_AUTH_TOKEN=
TWILIO_VALIDATE_SIGNATURE=false

ADMIN_TOKEN=change-me
DEFAULT_STYLE=casual_cool
USER_PHONE_NUMBER=
USER_NAME=Adam
ATTACHMENTS_DIR=/data/attachments
INBOUND_DEDUP_WINDOW_MINUTES=10
MAX_SMS_CHARS=320
WORKER_CONCURRENCY=1
